# -------------------------------------------------------------
# CodeNexus Flutter App - Environment Variables Example
# -------------------------------------------------------------

# Backend API URL (GraphQL endpoint)
# - Android Emulator: use 10.0.2.2 to refer to localhost of host machine
# - iOS Simulator: use 127.0.0.1
# - Physical Device (LAN): use your machine's local IP (e.g. 192.168.1.X)
API_URL=http://10.0.2.2:3000/graphql

# Backend WebSocket URL (Socket.IO for real-time code execution)
# Same rules as API_URL apply
WS_URL=http://10.0.2.2:3000
