# -------------------------------------------------------------
# CodeNexus Backend - Environment Variables Example
# -------------------------------------------------------------

# PostgreSQL Database Connection
# Replace with your actual database credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codenexus-postgres?schema=public"

# JWT Secret for Authentication
# Generate a strong, random string for production
JWT_SECRET="super-secret-codenexus-jwt-key-2026"

# RabbitMQ Connection
# Used for dispatching code execution tasks to the sandbox workers
RABBITMQ_URL="amqp://localhost:5672"

# Port for the NestJS Server
PORT=3000
